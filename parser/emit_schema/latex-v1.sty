% CSLv3 LaTeX Emit Style (latex-v1)
% Use with a XeLaTeX or LuaLaTeX compiler ; pdflatex won't render the
% glyphs without fallback macros.
\ProvidesPackage{cslv3}[2026/04/17 CSLv3 style]
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{unicode-math}
\RequirePackage{amsmath}
\RequirePackage{hyperref}
\RequirePackage{fontspec}

% Session-15 O4 : default monospace with broad Unicode coverage so that
% CSLv3 glyphs (⊢ ⌈ ⌉ ⟦ ⟧ ⊗ ∀ ∃ ...) render in section titles + prose,
% not only inside lstlisting's literate= mappings. DejaVu Sans Mono is
% ubiquitously available on MiKTeX+TeXLive ; falls back silently if
% absent so the package still parses.
\IfFontExistsTF{DejaVu Sans Mono}{
  \setmonofont{DejaVu Sans Mono}
}{%
  % fallback : unchanged (lmmono10) ; some glyphs render as boxes but
  % the document still compiles.
}

% Explicit Unicode-character mappings for glyphs that the default
% lmmono10 font lacks ; xelatex with \newunicodechar substitutes math-
% mode equivalents so section titles + prose render without boxes.
