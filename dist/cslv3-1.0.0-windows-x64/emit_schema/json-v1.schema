{
  "$schema":     "https://json-schema.org/draft/2020-12/schema",
  "$id":         "https://cslv3.apocky/schemas/json-v1.json",
  "title":       "CSLv3 Unified Emit Schema (json-v1)",
  "description": "AST + types + IR + diagnostics in one canonical document.",
  "type":        "object",
  "required":    ["schema", "schemaVersion", "source", "ast"],
  "properties":  {
    "schema":        { "type": "string", "const": "cslv3-emit-json" },
    "schemaVersion": { "type": "string", "const": "json-v1" },
    "emittedAt":     { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file":   { "type": "string" },
        "bytes":  { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string",  "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "ast": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/AstNode" }
      ]
    },
    "types": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "refine_obligations": { "type": "integer" },
            "strict_parse":        { "type": "boolean" },
            "diagnostics":         { "type": "array" }
          }
        }
      ]
    },
    "ir": {
      "oneOf": [
        { "type": "null" },
        { "type": "object",
          "properties": {
            "module": { "type": "string" },
            "ops":    { "type": "array" }
          }
        }
      ]
    }
  },
  "$defs": {
    "AstNode": {
      "type": "object",
      "required": ["kind", "text", "pos", "children"],
      "properties": {
        "kind":     { "type": "string" },
        "text":     { "type": "string" },
        "pos": {
          "type": "object",
          "required": ["line", "col", "byte"],
          "properties": {
            "line": { "type": "integer", "minimum": 0 },
            "col":  { "type": "integer", "minimum": 0 },
            "byte": { "type": "integer", "minimum": 0 }
          }
        },
        "suffix":   { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/AstNode" }
        }
      }
    }
  }
}
