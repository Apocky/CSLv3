§ CSLv3 SELF-DESCRIBED GRAMMAR
I> self-application: CSLv3 grammar expressed in CSLv3 notation
I> companion to §02 (BNF + prose) ; §13 compresses the same content in pure CSL
I> goal : demonstrate notation is expressive enough to describe itself
R! ← Lojban: unambiguous grammar expressible in its own grammar
R! ← reflective compilers (Scheme, MetaOCaml) : spec ≡ implementation primer

§ GRAMMAR-AS-DATA
  § token-class     : data    § lexer-emitted
  § slot-template   : data    § statement shape
  § node-kind       : data    § AST node taxonomy
  § production      : rule    § compound / expression / type forms
  § invariant       : gate    § LL(2), zero-ambiguity, silent-defaults

§ TOKEN-CLASSES 't
  token-class = enum[
    glyph, word, num, str, suffix, punct, newline, indent, dedent, eof
  ]

  def glyph't ⟨
    repr       : str ⌈len = 1..3⌉
    is-unicode : bool
    ascii-alt  : str?
    category   : tier              § tier-0 | tier-1 | tier-2
    bpe-cost   : u8 ⌈1..5⌉
  ⟩

  def word't   ⟨ text : str ⟩        § [A-Za-z_][A-Za-z0-9_-]*
  def num't    ⟨ lit : str , is-float : bool ⟩
  def str't    ⟨ body : str , raw : bool ⟩
  def suffix't ⟨ kind : type-suffix ⟩   § 'd 'f 's 't 'e 'm 'p 'g 'r

  def type-suffix = enum[
    data, func, system, type, entity, material, property, gate, rule
  ]

§ SLOT-TEMPLATE 'r
  § every statement occupies positions:
  slot := [EVIDENCE?] [MODAL?] [DET?] SUBJECT [RELATION] OBJECT [GATE?] [SCOPE?] [META?]

  def statement't ⟨
    evidence : evidence-mark?     ⌈default = ✓⌉
    modal    : modal-op?          ⌈default = assert⌉
    det      : determinative?     ⌈default = ∅⌉
    subject  : compound           W!
    relation : rel-op?            ⌈default = ':'⌉
    object   : value              W!
    gate     : gate-clause?
    scope    : scope-clause?
    meta     : comment?
  ⟩

  def evidence-mark = enum[ proven, confirmed, partial, pending, failed, unknown, hypothetical, deprecated ]
  def modal-op      = enum[ must, should, may, must-not, insight, question, push, decision, todo, fixme ]
  def determinative = enum[ system, field, spatial, entity, constraint, formula, quotation, temporal ]
  def rel-op        = enum[ bind, type-of, eq, arrow, implies, flows-into, member-of, subset, identical ]

  t∞: ∀ slot : default-value → ∅ at surface syntax   § Ithkuil rule

§ COMPOUND-FORMATION 'r
  § five operators ; recursive nesting ; left-to-right, innermost-first
  compound-op = enum[ TP, DV, KD, BV, AV ]

  ⟦ TP : A . B        = B-of-A     ⟧
  ⟦ DV : A + B        = {A,B} co-equal ⟧
  ⟦ KD : A - B        = B-that-is-A ⟧
  ⟦ BV : A ⊗ B       = thing-having-A+B ⟧
  ⟦ AV : @X           = at/per/in-scope-of X ⟧

  R! ambiguous-nesting → W! explicit '(' ')' grouping
  R! long-path → alias short = long.compound.path

§ MORPHEME-STACKING 'r
  § template: BASE.aspect.modality.certainty.scope
  morpheme-slot = enum[ aspect, modality, certainty, scope ]

  def aspect    = enum[ prog, perf, iter, hab, inch, term ]
  def modality  = enum[ must, may, cant, will, wont ]
  def certainty = enum[ cert, prob, poss, doubt ]
  def scope-morph = enum[ loc, glob, ctx ]

  ⟦ stack = base ('.' morpheme)*  ⌈|morpheme| ≤ 4⌉ ⟧

§ EXPRESSION-GRAMMAR 'r
  expr := atom | unary | binary | call | lambda | pipeline | block
  atom := num | str | ident | glyph-lit | pos-ref
  unary := ('¬' | '~' | '!' | '-') expr
  binary := expr op expr       § precedence table @ §02
  call := expr '⟨' args '⟩'
  lambda := 'λ' params '→' expr   ∨   '\' params '->' expr
  pipeline := expr ('|>' expr)+
  block := '{' stmt* expr? '}'
  match := 'match' expr '{' (pattern '→' expr)+ ('*' '→' expr)? '}'

§ TYPE-GRAMMAR 'r
  type := primitive | array | union | option | result | tuple | map | ref | linear | dep
  primitive = enum[ u8, u16, u32, u64, i8, i16, i32, i64, f32, f64, bool, str,
                    vec2, vec3, vec4, mat4, quat, rgba ]
  array    := '[' type ';' (num | '_') ']'
  union    := type ('|' type)+
  option   := type '?'
  result   := type '!'
  tuple    := '(' type (',' type)+ ')'
  map      := '{' type ':' type '}'
  ref      := '&' type
  linear   := type '!lin'
  dep      := 'Π⟨' ident ':' type '⟩' '→' type    § pi type
            | 'Σ⟨' ident ':' type ',' ident ':' type '⟩'  § sigma type
            | '{' ident ':' type '⊢' expr '}'             § refinement

§ DOCUMENT-STRUCTURE 'r
  document := section+
  section  := '§'+ name (':')? indent block dedent
  block    := statement*

  W! indent = scope-boundary (Peircean cut linearized)
  W! adjacent-items same-indent = conjunction (Peircean juxtaposition)

§ PARSE-PRIORITY 'r (high → low)
  glyph-prefix  : § @ # & * $
  enclosure     : ( ) [ ] { } ⟨ ⟩ ⟦ ⟧ « » ⌈ ⌉ ⌊ ⌋ ⟪ ⟫
  postfix-suffix: 'd 'f 's 't 'e 'm 'p 'g 'r
  unary         : ¬ ~ !
  access        : . ::
  arith         : * / % + -
  range         : ..
  comparison    : < > ≤ ≥ = ≠ ≈
  logic         : ∧ ∨ ⊕
  flow          : → ← ⇒ ↔ |> <|
  meta          : ⊢ ∴ ∵ ~>
  conditional   : ? :
  sequence      : , ;

§ INVARIANTS 'r
  t∞: ∀ statement : exactly-one-parse             § Lojban rule
  t∞: ∀ glyph ∈ spec : ∃ ASCII-alias (§12)         § J-rule
  t∞: lookahead = 2 tokens max                     § LL(2)
  t∞: default-slot-value → omitted-from-surface    § Ithkuil
  t∞: indent-2-spaces per level                    § Python-like
  t∞: juxtaposition = conjunction                  § Peirce
  t∞: self-describable (this file ← exists)        § reflexivity

§ SELF-REFERENCE
  I> this file describes the grammar of CSLv3
  I> this file is written in CSLv3 itself
  I> the grammar this file describes accepts this file as input
  I> therefore: parser(read("13_GRAMMAR_SELF.csl")) → valid-AST
  ⌈round-trip: AST → pprint → reparse → AST-shape-equal⌉

§ RELATION-TO-02
  @§02 : BNF + prose + human-orientation
  @§13 : dense-CSL + self-application + machine-orientation
  I> both encode identical grammar
  I> §13 is ~40% token count of §02 (compression via silent defaults + glyph reuse)

§ VERIFICATION
  ○ parser/parser.exe accepts 13_GRAMMAR_SELF.csl  W! verify
  ○ round-trip on 13_GRAMMAR_SELF.csl succeeds     W! verify
  ○ semantic pass finds morphemes in morpheme-stacking section
∎
