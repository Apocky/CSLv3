═════════════════════════════════════════════════════════════════
§ TASKS ← §§ Session-4-scope
═════════════════════════════════════════════════════════════════
  order : T14 → T15 → T16 → T17 → T18 → T19
  rationale :
    T14+T15 = wire-up Q3 decisions • unblock CI
    T16 = fuzzer • Session-3 commit-gate
    T17 = stratified-m1 • Apocky-requested
    T18 = physics-glyph audit • housekeeping
    T19 = cssllint-csl subcommand • T10-integration-enabler

  T14 : --strict / --strict-parse / --lint CLI flags ← §§ Q2+Q3
    modify : parser/main.odin
    add-flags :
      --lint          ⇒ warn-only exit-0
      --strict        ⇒ diag-ANY → exit-1
      --strict-parse  ⇒ PERMISSIVE_ACCEPT → parse-error exit-1
    combine : --strict + --strict-parse orthogonal
    default : no-flag = max-forgiveness
    semantic-table : from DECISIONS.md Q2
      dup-morpheme : always-E
      order : W→E@strict
      unknown : W→E@strict
      slot-arity : W@lint • E@default • E@strict
      evidence-adjacent : W∀-modes
      compound-assoc : I∀-modes (--verbose only)
    test-cases :
      tests/test_severity_modes.py (new) ~150-LOC
      cover ∀ 6-checks × 3-modes = 18-assertions
    acceptance :
      ✓ --strict on tutorial.csl = exit-0 (no-diag)
      ✓ --strict on bad-fixture = exit-1 (E-diag)
      ✓ --lint on bad-fixture = exit-0 (W-diag stderr)

  T15 : PERMISSIVE_ACCEPT tagging ← §§ Q3-action-2+3
    modify : parser/error_tests/*.csl 13-files (the permissive-13)
    add-header : `# permissive: true` first-line comment
    modify : tests/test_error_recovery_corpus.py
      read-header to-populate-category ¬ hardcoded-list
    modify : parser/semantic.odin
      emit W-level "permissive-accept" diagnostic
      kind = new SemDiag_Permissive
      default-severity = W ; --strict-parse = E
    acceptance :
      ✓ grep 'permissive: true' parser/error_tests/ = 13-matches
      ✓ parser --semantic on permissive-fixture = 1-W-diag
      ✓ parser --strict-parse on permissive-fixture = exit-1

  T16 : fuzzer ≥ 1000-inputs ← §§ Session-3-commit-gate
    new : tests/test_fuzz_roundtrip.py
    strategy :
      mutation-based : start-with tests/*.csl + error_tests/*.csl
      mutators :
        token-delete (P=0.2)
        token-insert (P=0.2)
        token-swap (P=0.2)
        glyph-substitute (P=0.2) ← swap ≤ ↔ ≥ etc
        indent-perturb (P=0.1)
        bracket-flip (P=0.1) ← ⟨→{ etc
      seed : 20-fixtures × 50-mutations = 1000-cases
      seeded-random : reproducible per-run (seed in-argv)
    invariants-checked :
      R1 no-crash
      R4 no-hang (5s-timeout per-case)
      R5 parser-exit-code ∈ {0,1} ← never-panic-127
    budget :
      total ≤ 60s on dev-hw
      ≥ 1000-executions
      CI-gate : block-on-R1-or-R5 violation
    acceptance :
      ✓ 1000+ executions in ≤ 60s
      ✓ 0 crashes (R1)
      ✓ 0 hangs (R4)
      ✓ findings-log tests/fuzz_findings.md with-any-novel-shapes

  T17 : stratified m₁ per-mode ← §§ Apocky-future-open
    update : specs/10_EVAL.csl
    add-table :
      | mode      | m₁-target | rationale
      |-----------|-----------|----------
      | pure-CSL  | ≤ 0.5     | max-density authoring
      | bridge    | ≤ 0.9     | mixed EN+CSL reference
      | prose     | ≤ 0.95    | mostly-English bullets
    update : eval/RESULTS.md header
      per-file : declare mode in-preamble
      metric-check per-mode-threshold
    update : eval/metric.py (if-exists) or scripts/compute_m1.py
      parse mode-declaration
      apply-threshold per-mode
    backward-compat :
      ∀ existing-C1..C7 declare-mode upfront
      C5 declared bridge ← 0.821 < 0.9 ✓
      C1-C4+C6+C7 declared pure ← verify-all < 0.5
    acceptance :
      ✓ 7/7 still-pass under-new-stratified-gate
      ✓ eval/RESULTS.md reflects-per-mode

  T18 : tier-2 physics-glyph audit ← §§ housekeeping
    scan : specs/*.csl + eval/*.csl + tests/*.csl + examples/*.csl
    target-glyphs : ρ μ σ κ ε τ (tier-2 physics-set)
    classify :
      used ≥ 1-site : keep + document-where
      unused : propose-deletion
    output : diag/TIER2_USAGE_AUDIT.md
      per-glyph : site-count + sample-contexts
      recommendation : keep | demote-to-tier3 | delete
    if-delete-recommended :
      ¬ delete-yet ← Apocky-decision-required
      write-recommendation-only
    acceptance :
      ✓ audit-file exists + commits
      ✓ per-glyph decision surfaced
      ✓ no-spec-edits without-Apocky-approval

  T19 : cssllint-csl subcommand ← §§ T10-integration-enabler
    ref : specs/14_CSSLv3_BRIDGE.csl
    purpose : expose cslparser as embeddable lint/format backend
      for CSSLv3-compiler consumption
    new : parser/main.odin add-subcommand `cssllint`
      invoke : parser.exe cssllint <file.csl> [--json]
      --json flag ⇒ machine-readable diagnostics output
      json-shape :
        { file, diags: [ { line, col, sev, code, msg } ], status }
      sev ∈ {info,warn,error}
      code-namespace : CSL-E-XXX / CSL-W-XXX / CSL-I-XXX
    test :
      tests/test_cssllint_json.py
      parse-output via-Python stdlib json
      verify-schema
    document :
      specs/14_CSSLv3_BRIDGE.csl add-section §§ LINT-PROTOCOL
    acceptance :
      ✓ cssllint-subcommand works standalone
      ✓ --json emits valid-JSON
      ✓ diag-codes documented
      ✓ CSSLv3-repo can-shell-out to use it

