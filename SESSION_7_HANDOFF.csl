§ T26.a smt.odin — Formula AST
  lines = ~580
  kinds : Var BoolC IntC RealC BvC Apply Ite Let Quant
  sorts : Bool Int Real BitVec<N> Array<idx,elem> Sym
  theories : QF_UF QF_LIA QF_LRA QF_NIA QF_NRA QF_BV QF_UFLIA QF_UFLRA
             AUFLIA AUFLIRA ALL
  builders : f_var f_true f_false f_int f_real f_bv
             f_apply f_applyv f_not f_and f_or
             f_implies f_eq f_neq f_lt f_le f_gt f_ge
             f_add f_sub f_mul f_div_i f_mod_i f_div_r f_neg
             f_ite f_select f_store f_forall f_exists f_let
             quant_add_trigger
  script-API : new_script script_set_option script_declare_const
               script_declare_fun script_declare_sort script_assert
               script_autodecl_from_formula
  infer_theory : auto-selects tightest-logic from assertion-shape +
                 declaration-sorts ; detects non-linear via Apply('*'/'div'/'mod')
                 with two non-constant args

§ T26.b smt_emit.odin — SMT-LIB2 emitter
  lines = ~180
  layout :
    (set-logic ...) (set-option :produce-models ...) (set-option :produce-unsat-cores ...)
    (set-option ...)* sorted-by-key
    (declare-sort ...)* sorted-by-name
    (declare-const ... | declare-fun ...)* sorted-by-name
    (assert ...)+ user-order-preserved
    (check-sat) [(get-model)] [(get-unsat-core)]
  determinism-proof : CASE-7 selftest hashes-identical for scripts
                      with identical content + different insertion-order
  quantifier-trigger-emit : (! body :pattern (p1 p2 ...) :pattern (...))

§ T26.c smt_morpheme.odin — morpheme encoding
  lines = ~170
  map :
    'd durative     → (> (duration v) 0)
    'f final        → (terminal v)           UF-Bool
    's state        → true  (type-level-only)
    't transitive   → (>= (arity v) 2)
    'e experiential → (exists ((a Agent)) (observed-by v a))
    'm modal        → (exists ((k ModKind)) (modal-kind v k))
    'p perfective   → (completed v)          UF-Bool
    'g generic      → (forall ((α MorphVal)) true)  — tautology placeholder
    'r reflexive    → (= (subject v) (object v))
  UF-decls (one-per-script via morpheme_declare_ufs):
    sorts : MorphVal, Agent, ModKind
    funs  : duration, terminal, arity, observed-by, modal-kind,
            completed, subject, object
  stack-composition : morpheme_stack_predicate folds [tag,...] via f_and
                      ; trivial-true (s/g) filtered out

§ T26.d smt_obligation.odin — collection + driver
  lines = ~370
  Obligation_Kind : Refinement_Assert Morpheme_Compose Array_Bounds
                    Div_Nonzero Overflow_Free Lipschitz_Compose
                    Effect_Subeffect Termination
  Smt_Result : Pending Unsat Sat Unknown Timeout Error Skipped
  collect_from_refine_queue : walks refine.odin queue snapshot
  collect_from_ir(module) : walks IR-tree for :
    OP_REFINE → Refinement_Assert
    OP_MORPH  → Morpheme_Compose
    OP_FN with morpheme-attr → Refinement_Assert (T26-extension ;
                                 catches lower.odin's fn-morpheme-stash)
    OP_DIV/OP_MOD → Div_Nonzero
  discharge(oblig, cfg) :
    1 canonical_emit → SHA-256 cert_hash
    2 cache-lookup via cache_lookup(dir, hash)
    3 pick_solver(Z3 preferred ; CVC5 fallback)
    4 solve_with(solver, text, timeout, path)
    5 if-Z3-Unknown + CVC5-available → retry
    6 cache_store for Unsat/Sat/Timeout
    7 accumulate Discharge_Result counts

§ T26.e smt_cache.odin — proof-cache
  lines = ~220
  location : .proof-cache/<hash[:2]>/<hash[2:]>.json
  entry : {hash, result, solver, timestamp, canonical_head}
  hash  : SHA-256 hex (Odin core crypto.hash)
  layout : 256 sharded-subdirs ∵ NTFS-scale ; git-style
  helpers : cache_init cache_lookup cache_store cache_file_count
            sha256_hex_of_string sha256_hex_of_bytes
            time_now_ms time_now_iso8601

§ T26.f smt_solver.odin — Z3/CVC5 driver
  lines = ~150
  transport : tempfile at %TEMP%/cslv3_<solver>_<ctr>_<ms>.smt2
  Z3 args   : -T:<seconds>  -smt2  <tempfile>
  CVC5 args : --tlimit=<ms> --lang=smt2 <tempfile>
  response-parse : first non-comment line → Unsat|Sat|Unknown|Timeout
  solver_available : path-exists probe before invoke
  solver_version   : runs `-version`/`--version` for CI preamble
  graceful-degrade : missing-solver → return Error + false (never-panic)

§ T26.g smt_audit.odin — proof-cert chain
  lines = ~280
  location : .proof/chain.jsonl + .proof/keys/{private,public}.key
  entry : {seq, prev_hash, ctx, result, solver, cert_hash,
           timestamp, sig}
  sig   : base64 Ed25519 over canonical-concat of all other fields
  chain-root : genesis entry (seq=0, prev_hash="") signed at init
  verify : walks top-to-bottom ; checks seq-continuity + prev_hash-link +
           per-entry signature ; returns (ok, n_verified)
  key-mgmt : audit_init generates keypair if absent (dev-stub)

§ T26.h main.odin CLI surface
  new Mode : Smt
  flags :
    --smt                     enter SMT-discharge mode
    --smt --json              machine-readable JSON w/ obligations[] + counts
    --smt --dump-lib2         emit canonical SMT-LIB2 per-obligation, exit
    --smt --verbose           show per-obligation details in text mode
    --smt --no-cache          bypass proof-cache + audit-chain
    --smt --solver=z3|cvc5    force-solver-choice
    --smt --timeout=10s|100ms timeout override (suffix : s|ms|m)
    --smt --z3=<path>         Z3 binary location (auto-detects via Z3_PATH env +
                              choco default + PATH)
    --smt --cvc5=<path>       CVC5 binary location
    --smt --strict            Unknown/Timeout → rc=1 (CI-gate)
    parser --smt-selftest     programmatic self-test (10+ cases ; optional
                              Z3-roundtrip w/ --z3=<path>)
  find_solver_default : env-var > choco-default > PATH-probe chain
  parse_timeout       : numeric + suffix (s/ms/m)

