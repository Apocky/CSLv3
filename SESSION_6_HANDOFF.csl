§ T21.a ir.odin
  lines = 331
  types :
    Attr         tagged w/ Int/Float/Str/Bool/Symbol/Sig/Type/Label kinds
    Value        ptr-identity ; def_kind = From_Op | From_Block_Arg
    Block        id + label + args:[^Value] + ops:[^Op] + parent:^Region
    Region       id + blocks:[^Block] + parent_op + kind:Region_Kind
    Op           id + name + operands + results + regions + attrs + loc + parent
    Module       ops:[^Op] + attrs + source_file
  enums :
    Region_Kind  Generic Fn_Body If_Then If_Else While_Cond While_Body
                 For_Body Match_Arm Match_Default Handler_Body
  op-name-consts :
    OP_MODULE OP_FN OP_RETURN OP_CONST OP_VAR_REF
    OP_RECORD OP_PROJ OP_VARIANT OP_MATCH
    OP_ADD OP_SUB OP_MUL OP_DIV OP_MOD
    OP_EQ OP_NEQ OP_LT OP_LE OP_GT OP_GE
    OP_AND OP_OR OP_NOT
    OP_IF OP_WHILE OP_FOR OP_BREAK OP_CONT
    OP_CALL OP_MORPH OP_REFINE
    OP_COMP_OF OP_COMP_AND OP_COMP_THAT_IS OP_COMP_HAVING OP_COMP_AT
    OP_EFF_PERFORM OP_EFF_HANDLE
  builders :
    new_value value_from_op value_from_block_arg
    new_block block_add_arg block_append_op block_terminator
    new_region region_add_block region_entry_block
    new_op op_add_operand op_add_result op_add_region op_set_attr op_get_attr
    op_is_terminator
  helpers :
    ir_op_is_binop ir_binop_result_ty attr_repr

§ T21.b lower.odin
  lines = 685
  entry : lower_source(doc, tc, source_file) -> Lower_Result
  dispatch :
    lower_document  → Document / Section / Function_Def / Type_Def / Enum_Def / Definition
    lower_fn        → OP_FN + Fn_Body region + entry block + block-args per param
    lower_top_def   → wraps top-level let-binding as zero-arg fn
    lower_stmt      → Definition / Expr_Stmt / Relation / Conditional / ForAll_Stmt / Block
    lower_expr      → Num_Lit Str_Lit Bool_Lit Nil_Lit Ident Binary Unary Call
                      Compound_Expr Conditional Group Tuple List Record
                      Match_Stmt Block Lambda Type_Prim  (15+ node kinds)
  SSA-construction : Braun-style on-the-fly via value_map + env-stack
  value-map        : rawptr(AST-Node) → ^Value for use-def wiring
  env-stack        : [dynamic]map[string]^Value for lexical scoping
  morpheme preservation : Definition w/ non-Invalid suffix wraps the let-body
                          result in OP_MORPH w/ attr tag=<morpheme-name>
  curried fn-sig   : multi-arg fn lowered as A → B → C → R ; entry block
                     carries N block-args, one per declared param

§ T21.c ir_verify.odin
  lines = ~500
  strategy : error-accumulating ; structural-first ; read-only walk
  check-classes :
    V1 region-shape         verify_region_kinds per op-name table
    V2 terminator-presence  every non-empty block ends w/ op_is_terminator op
    V3 terminator-kind      terminator appropriate for Region_Kind (yield only
                            inside If_Then/If_Else/While_Body/For_Body/Match_Arm ;
                            branch/cond_branch inside Fn_Body/While_Cond ; etc.)
    V4 use-before-def       DFS-walk ; `defined` set grows as we descend ;
                            op.operand ∈ defined required
    V5 type-consistency     per-op signature checks :
                              arith-binop : lhs.ty = rhs.ty ; not-Bool/String/Symbol
                              compare     : lhs.ty = rhs.ty ; result = bool
                              bool-binop  : both operands bool ; result bool
                              not         : operand bool
                              const       : attr-kind matches result-type-prim
                              return      : operand.ty = walk-chain(fn.sig, n_params)
                              if          : condition bool ; regions=[If_Then,If_Else]
                              while/for   : region-shape
                              match       : all arms Match_Arm|Match_Default
                              morph/refine: required attr present
                              call        : arg[0].ty compat w/ callee.from
    V5-extra dangling-value : Value.def_op or def_block nil ⇒ flag
  diagnostic codes :
    CSL-E-300 ir-lower              (lowering-phase errors forwarded)
    CSL-E-310 ir-region-shape
    CSL-E-311 ir-missing-terminator
    CSL-E-312 ir-terminator-kind
    CSL-E-320 ir-use-before-def
    CSL-E-330 ir-type-mismatch
    CSL-E-340 ir-dangling-value
  types_compat : follow()-aware ; permissive on var-side ; deep-walk
                 Arrow / Con / Tagged / Refine / Tuple / Record|Variant (via row_compat)

§ T21.d ir_print.odin
  lines = ~180
  format : MLIR-flavor textual
    module @<src> {
      %N[, %N]* = <op-name>(%N[, %N]*) {<attr=val>,...} : <ty>[, <ty>] { <regions> }
      ^<label>(%N:name : T):
        <ops>
    }
  determinism : attrs emitted in sorted-by-key order (slice.sort)
  values      : %<id> ; :<name> suffix if friendly-name present
  types       : type_repr (from T20 types.odin)

§ T21.e ir_json.odin
  lines = ~300
  schema :
    { module, ops:[ op ] }
    op    = { id, name, pos{line,col,byte}, operands:[id], results:[val-def],
              attrs:{key:{kind,value}}, regions:[region] }
    region= { kind, blocks:[block] }
    block = { id, label, args:[val-def], ops:[op] }
    val-def = { id, name, ty, kind }
  determinism : all maps emitted w/ sorted keys
  indent      : 2-space line-oriented for golden-diffability

§ T21.f main.odin wiring
  Mode += Ir
  new CLI flags :
    --ir                enter IR mode (lower + print)
    --ir --json         JSON IR dump w/ counts + diags
    --ir --verify       run verifier + emit diagnostics
    --ir --verify --strict  W→fail for CI gate
    parser --ir-selftest    (positional arg ; no file)
  ir_cli proc :
    parse → typecheck → lower_source → [optional ir_verify] → print or JSON
    exit-code : 1 on any error OR (strict && any warn)

§ T21.g test harness
  files-new :
    parser/ir_selftest.odin   5 programmatic bad-IR cases ; emits CASE N: PASS/FAIL
    tests/test_ir_integration.py  6 gates :
      G1 selftest 5/5 PASS
      G2 every parser/tests/C*.csl lowers+verifies clean (0 errors)
      G3 --ir --json --verify : well-formed JSON + status="ok"
      G4 --ir text : starts "module" ; ends "}"
      G5 --strict : clean rc=0
      G6 ir_bad/ : placeholder (skipped when empty ; ready for future fixtures)
  selftest cases :
    CASE 1 missing-terminator    block w/ const-only, no return
    CASE 2 use-before-def        stray Value w/ nil def_op referenced as operand
    CASE 3 type-mismatch         OP_ADD w/ lhs:i32 + rhs:bool
    CASE 4 region-shape          OP_FN w/ 2 regions (expected exactly 1)
    CASE 5 terminator-kind       cslv3.if w/ then-block ending in cslv3.branch
                                 (only yield/break/cont/return allowed in If_Then)

