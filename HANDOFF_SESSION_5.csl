  § T20 : TYPE-CHECKER ← semantic.odin next-layer • FULL-OPTIMAL
    W! PhD-grade ← Apocky-standing-directive "optimal ≠ minimal"
    design-pillars :
      a Hindley-Milner unification w/ row-polymorphism (Koka-lineage)
      b refinement-types via tag-suffix ('d 'f 's 't 'e 'm 'p 'g 'r)
      c dependent-kinds for ∀/∃/Π/Σ (spec13-grammar-ready)
      d bidirectional check + infer (Dunfield-Krishnaswami 2013)
      e structural record-typing w/ width-subtyping
    files-new :
      parser/types.odin         ~600-LOC Type + Row + Subst + Scheme
      parser/unify.odin         ~400-LOC occurs-check + row-unify
      parser/infer.odin         ~700-LOC bidirectional inference
      parser/refine.odin        ~300-LOC morpheme→refinement-tag
      tests/test_types.odin     ~200-LOC unit-tests (Odin-native)
      tests/test_typecheck.py   ~250-LOC integration via parser CLI
    type-surface :
      T ::= α | Int | Float | String | Bool | Symbol
          | T → T / ε              function-with-effect-row
          | {ℓ:T, ρ}                record-row-poly
          | [ℓ:T | ρ]               variant-row-poly
          | ∀ᵏα.T                   polymorphic-with-kind
          | Πx:T.T'                 dependent-product
          | Σx:T.T'                 dependent-sum
          | {v:T | φ(v)}            refinement
          | T^tag                   morpheme-refined
      ε ::= ⟨⟩ | ⟨ℓ:E | ε⟩ | μ       effect-row
      κ ::= ★ | κ→κ | Row ε | Refine φ  kinds
    morpheme→refinement map :
      'd durative       → {v | duration(v) > 0}
      'f final          → {v | terminal(v)}
      's state          → StateTag<ref τ>
      't transitive     → Arrow arity≥2
      'e experiential   → ObservedBy<agent>
      'm modal          → Modal<kind>
      'p perfective     → Completed<τ>
      'g generic        → ∀α.α version
      'r reflexive      → {v | subject(v)=object(v)}
    algorithm :
      walk AST → generate constraints → solve (unify) → substitute → check
      refinement-obligations deferred to SMT-queue (Session-6+ Z3)
      effect-row inference w/ Xie+Leijen evidence-passing prep
    CLI :
      parser --typecheck <file>            → diags + types-annotated-tree
      parser --typecheck --json <file>     → machine-readable
      parser --typecheck --strict <file>   → any-obligation-unresolved = E
    severity-integration :
      type-mismatch       : always-E
      row-mismatch        : always-E
      unresolved-refine   : W@default • E@strict
      ambiguous-infer     : W@default • E@strict
      unused-binding      : W@default (keep-lenient)
      shadow-warning      : I-always
    diagnostic-codes : CSL-E-200..299 (type) + CSL-W-200..299 + CSL-I-200..299
    tests : 20+ positive + 15+ negative + 10+ row-poly + 5+ dependent
    acceptance :
      ✓ C1-C7 eval-corpus type-check clean under --default
      ✓ deliberate-bug fixtures tests/type_bad/*.csl all-flag correctly
      ✓ row-poly test : open-record extension preserves-row-var
      ✓ dependent-type : Vec n α declared-and-used across fn-sig
      ✓ morpheme-refinement : 'd'f composition inferred-correctly
      ✓ JSON output schema-validated
      ✓ typecheck-throughput ≥ 10k-nodes/s on dev-hw

  § T22 : GAP-FIXTURE PROMOTION ← close Session-4 gaps
    targets : c01 c02 s02 t02 p04 (5 fixtures marked permissive w/ detection-gaps)
    approach : add parse-time markers that semantic-layer detects
    per-gap :
      c01 : trailing dot w/o field-target variant → already meta="." ; extend
      c02 : trailing @ w/o target variant → extend meta="@"
      s02 : empty slot bracket → parser marks meta="empty-slot"
      t02 : bare-type-arg no-body → parser marks meta="bare-type"
      p04 : malformed-prose-modal → parser marks meta="bare-modal"
    semantic-layer : Permissive_Accept code surfaces W@default
    strict-parse : promotes to E
    tests : update tests/test_permissive_accept.py remove-gap-list
    acceptance :
      ✓ 18/18 permissive cases detected (13+5)
      ✓ 0 documented-gaps remaining
      ✓ --strict-parse on gap-fixtures → exit-1

  § T23 : COMMENT-PRESERVATION RT ← lexer.emit_comments=true
    rationale : doc-generation • hot-reload (downstream) • faithful-RT
    design :
      Token_Kind += .Comment_Line + .Comment_Block
      lexer : always emit (default-on)
      AST : Comment node attaches to nearest-following-stmt
      pprint : emit Comment inline respecting mode
    files-modified :
      parser/token.odin      +2 kinds
      parser/lexer.odin      emit_comments=true default • multiline-block support
      parser/ast.odin        Comment node + Comment_Attached field on Stmt
      parser/parser.odin     attach-comment-to-next-stmt
      parser/pprint.odin     Comment-case ∀ 5-modes
    RT-invariant upgraded : AST-shape + comment-position
    tests : tests/test_comments_rt.py ~150-LOC
    cases :
      line-comment before-stmt
      line-comment after-stmt (trailing)
      block-comment before-stmt
      block-comment mid-expr (block-level only)
      nested-blocks
      mode × comment-style matrix
    acceptance :
      ✓ 7/7 C-corpus RT with-comments (extend tests/*.csl if-needed)
      ✓ all-5 pprint-modes preserve comments
      ✓ fuzzer includes comment-mutators

