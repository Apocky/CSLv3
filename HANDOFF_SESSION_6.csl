§§ DESIGN-PILLARS
  a SSA form ← single-assignment • use-def tracked
  b structured-regions ← nested blocks within ops (MLIR-pattern)
  c op-with-regions ≡ first-class (fn-def • if • while • match)
  d typed-values ← T20 types propagated through IR
  e morpheme-as-op ← cslv3.morpheme.tag preserves-surface-info
  f refinement-as-assertion ← cslv3.refinement.assert deferred-SMT
  g effect-row ← propagated per-op for Session-9+ effects integration
  h verifier ← structural invariants enforced (no-use-before-def • region-shape • type-match)

§§ FILES-NEW
  parser/ir.odin            ~800-LOC  IR types + builders
    Module struct
    Op { name, operands, results, regions, attrs, type, loc }
    Region { blocks }
    Block { args, ops, terminator }
    Value { ty, def : Op | Block_Arg }
    Attr { kind, payload }
    Type_Ref ← from parser/types.odin
  parser/lower.odin         ~700-LOC  typed-AST → IR
    lower_module + lower_fn + lower_expr + lower_stmt
    context : fresh-name generator • value-map • scope-stack
    morpheme → cssl.morpheme.tag op
    refinement → cssl.refinement.assert op (type carries constraint)
  parser/ir_print.odin      ~400-LOC  MLIR-like textual format
    `%0 = cslv3.const 42 : Int`
    `cslv3.fn @sort(%arr : List[Int]) -> List[Int] { ... }`
    structured-regions = nested-braces
    attrs = {key = value, ...}
  parser/ir_verify.odin     ~500-LOC  structural invariants
    use-before-def check
    type-consistency per-op (signature match)
    region-shape (fn = 1 region • if = 2 regions • while = 1 region + cond)
    terminator-present in every block
    no-dangling values
  parser/ir_json.odin       ~300-LOC  JSON output for CSSLv3-integration
    schema : { module, ops : [{name, operands, results, regions, attrs, type, loc}] }
  tests/test_ir.odin        ~300-LOC  Odin-native unit tests
    builders + basic shapes
  tests/test_ir_integration.py ~400-LOC  golden-diff IR-dumps
    7 C-corpus files → lower → print → diff vs golden
    JSON output validated

§§ IR-OP INVENTORY (initial set)
  § module + fn
    cslv3.module
    cslv3.fn        (attrs: name, signature) (region: body)
    cslv3.return    (terminator)
  § values + primitives
    cslv3.const     (attr: value) (result: T)
    cslv3.var_ref   (attr: name) (result: T)
  § records + variants
    cslv3.record    (operands: field-values) (attrs: labels) (result: record-type)
    cslv3.proj      (operand: record) (attr: label) (result: field-type)
    cslv3.variant   (operand: payload) (attr: label) (result: variant-type)
    cslv3.match     (operand: scrutinee) (regions: arms, default)
  § arithmetic + comparison (generic-on-type)
    cslv3.add/sub/mul/div/mod
    cslv3.eq/neq/lt/le/gt/ge
    cslv3.and/or/not
  § control-flow (structured)
    cslv3.if        (operand: cond) (regions: then, else)
    cslv3.while     (regions: cond, body)
    cslv3.for       (operands: iter) (regions: body)
    cslv3.break     (terminator)
    cslv3.continue  (terminator)
  § calls
    cslv3.call      (operand: fn, args) (result: T)
  § morpheme + refinement (T20-integration)
    cslv3.morpheme.tag     (operand: v) (attr: morpheme) (result: T^tag)
    cslv3.refinement.assert (operand: v) (attr: predicate) (result: {v : T | P})
  § compound-operators (from CSLv3 notation)
    cslv3.compound.of      .(of) karmadhāraya
    cslv3.compound.and     +(and)
    cslv3.compound.that_is -(that-is)
    cslv3.compound.having  ⊗(having)
    cslv3.compound.at      @(at)
  § effect (prep for Session-9+ integration)
    cslv3.effect.perform   (attr: effect-name)
    cslv3.effect.handle    (regions: body, handler)

§§ LOWERING-PIPELINE
  1 typed-AST (from T20 infer.odin) = input
  2 raise-implicit ← resolve-sugar (compound-operators → ops)
  3 desugar-morphemes ← 'd'f'... → cssl.morpheme.tag op
  4 emit-IR ← walk typed-AST • build ops + regions
  5 verify ← ir_verify.odin checks all-invariants
  6 output ← textual (ir_print) OR JSON (ir_json)

§§ CLI-SURFACE
  parser --ir <file>            → IR textual form (default MLIR-like)
  parser --ir --json <file>     → IR JSON (CSSLv3-consumption)
  parser --lower-from=ast --to=ir  (stages exposed for debugging)
  parser --ir --verify <file>   → run verifier • emit errors
  parser --ir --strict <file>   → verify errors = exit-1

§§ SEVERITY-INTEGRATION
  use-before-def      : always-E
  type-mismatch-op    : always-E
  region-shape-wrong  : always-E
  terminator-missing  : always-E
  dangling-value      : W@default • E@strict
  unused-op           : W@default (keep-lenient)
  diagnostic-codes : CSL-E-300..399 (IR) + CSL-W-300..399

§§ GOLDEN-IR-DUMPS
  commit .ir.txt alongside each eval/*.csl + tests/*.csl
  CI-diff : parser --ir <file> vs <file>.ir.txt
  update via : parser --ir <file> > <file>.ir.txt (explicit)
  7 C-corpus files get golden dumps

